# =====================================================================
# SNEAK CONNECT PETS - ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. DATABASE CONNECTION (Secret - Server / Worker Runtime Only)
# PostgreSQL connection string for Drizzle ORM + pg.Pool.
# For Cloudflare Workers deployments, supply a connection-pooled PostgreSQL URL
# (e.g. from Supabase with Transaction Pooler port 6543, Neon pooled URL, or AWS RDS).
# Set in Cloudflare Dashboard: Settings -> Variables -> Secrets -> DATABASE_URL
DATABASE_URL=postgresql://postgres:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# 2. CANONICAL PUBLIC SITE URL (Public / Build-time Variable)
# The canonical URL where this application is hosted.
# Used for metadata, canonical links, and absolute URL generation.
# Set in Cloudflare Dashboard: Settings -> Variables -> Environment Variables -> NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_SITE_URL=https://pet-animal.workers.dev
